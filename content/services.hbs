<style>
	a[href="./services.html"] {
		color: black;
		text-decoration: none;
	}

	.services-list {
		list-style: none;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	@media (max-width: 600px) {
		.services-list {
			grid-template-columns: 1fr;
		}
	}

	.service-link {
		display: block;
		position: relative;
		text-decoration: none;
	}

	.service-link img {
		width: 100%;
		display: block;
		aspect-ratio: 333 / 142;
		object-fit: cover;
	}

	.service-link span {
		position: absolute;
		top: 50%;
		left: 0;
		right: 0;
		transform: translateY(-50%);
		color: white;
		font-size: 20px;
		background-color: rgba(0,0,0,0.5);
		padding: 8px 0;
		text-align: center;
	}
</style>

